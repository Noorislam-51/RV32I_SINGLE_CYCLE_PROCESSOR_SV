// --- Setup ---
00500093    // 0x000: ADDI x1, x0, 5        (x1 = 5)
00A00113    // 0x004: ADDI x2, x0, 10       (x2 = 10)
FFF00193    // 0x008: ADDI x3, x0, -1       (x3 = 0xFFFFFFFF)

// --- R-Type (10) ---
00208233    // 0x00C: ADD  x4, x1, x2       (15)
401102B3    // 0x010: SUB  x5, x2, x1       (10-5 = 5)
00209333    // 0x014: SLL  x6, x1, x2       (5<<10 = 5120)
0011A3B3    // 0x018: SLT  x7, x3, x1       (signed -1<5 = 1; unsigned would give 0)
0030B433    // 0x01C: SLTU x8, x1, x3       (unsigned 5<FFFFFFFF = 1; signed would give 0)
0020C4B3    // 0x020: XOR  x9, x1, x2       (15)
00235533    // 0x024: SRL  x10, x6, x2      (5120>>10 = 5)
4021D5B3    // 0x028: SRA  x11, x3, x2      (-1>>>10 = -1; SRL would give 003FFFFF)
0020E633    // 0x02C: OR   x12, x1, x2      (15)
0020F6B3    // 0x030: AND  x13, x1, x2      (0)

// --- I-Type ALU (9) ---
00308713    // 0x034: ADDI  x14, x1, 3      (8)
00209793    // 0x038: SLLI  x15, x1, 2      (20)
0060A813    // 0x03C: SLTI  x16, x1, 6      (5<6 = 1)
FFF0B893    // 0x040: SLTIU x17, x1, -1     (5 < FFFFFFFF unsigned = 1)
0050C913    // 0x044: XORI  x18, x1, 5      (0)
00115993    // 0x048: SRLI  x19, x2, 1      (5)
4011DA13    // 0x04C: SRAI  x20, x3, 1      (-1; SRLI would give 7FFFFFFF)
0080EA93    // 0x050: ORI   x21, x1, 8      (13)
0070FB13    // 0x054: ANDI  x22, x1, 7      (5)

// --- Stores (3) ---
00102023    // 0x058: SW x1, 0(x0)          (mem[0..3] = 00000005)
00300223    // 0x05C: SB x3, 4(x0)          (mem[4]    = FF)
00301323    // 0x060: SH x3, 6(x0)          (mem[6..7] = FFFF)

// --- Loads (5) - negative data so sign/zero extension is actually tested ---
00002B83    // 0x064: LW  x23, 0(x0)        (00000005)
00400C03    // 0x068: LB  x24, 4(x0)        (FFFFFFFF sign-extended)
00601C83    // 0x06C: LH  x25, 6(x0)        (FFFFFFFF sign-extended)
00404D03    // 0x070: LBU x26, 4(x0)        (000000FF zero-extended)
00605D83    // 0x074: LHU x27, 6(x0)        (0000FFFF zero-extended)

// --- Branches (6) - each taken branch skips a trap; not-taken guard first ---
00109063    // 0x078: BNE  x1, x1, 0        (must NOT branch; if taken it loops here forever)
00108463    // 0x07C: BEQ  x1, x1, 8        (taken)
0000006F    // 0x080: JAL  x0, 0            (trap: stuck here = branch/jump before it failed)
00209463    // 0x084: BNE  x1, x2, 8        (taken)
0000006F    // 0x088: JAL  x0, 0            (trap: stuck here = branch/jump before it failed)
0011C463    // 0x08C: BLT  x3, x1, 8        (taken: -1 < 5 signed)
0000006F    // 0x090: JAL  x0, 0            (trap: stuck here = branch/jump before it failed)
0030D463    // 0x094: BGE  x1, x3, 8        (taken: 5 >= -1 signed)
0000006F    // 0x098: JAL  x0, 0            (trap: stuck here = branch/jump before it failed)
0030E463    // 0x09C: BLTU x1, x3, 8        (taken: 5 < FFFFFFFF unsigned)
0000006F    // 0x0A0: JAL  x0, 0            (trap: stuck here = branch/jump before it failed)
0011F463    // 0x0A4: BGEU x3, x1, 8        (taken: FFFFFFFF >= 5 unsigned)
0000006F    // 0x0A8: JAL  x0, 0            (trap: stuck here = branch/jump before it failed)

// --- v2 EDGE CASES. Guard = 'Bxx ..., 0': branches to ITSELF, so if the condition is wrong the PC sticks on that exact line ---

// --- v2-1 Branch edges: not-taken + equal operands ---
00208063    // 0x0AC: BEQ  x1, x2, 0        (5==10 false -> must NOT take)
0010C063    // 0x0B0: BLT  x1, x1, 0        (5<5 false -> must NOT take; catches BLT built as <=)
0010E063    // 0x0B4: BLTU x1, x1, 0        (must NOT take)
0010D463    // 0x0B8: BGE  x1, x1, 8        (5>=5 true -> taken; catches BGE built as >)
0000006F    // 0x0BC: JAL  x0, 0            (trap: stuck here = branch/jump before it failed)
0010F463    // 0x0C0: BGEU x1, x1, 8        (taken)
0000006F    // 0x0C4: JAL  x0, 0            (trap: stuck here = branch/jump before it failed)

// --- v2-2 Backward branch (negative B-immediate) - 3-pass loop ---
00300E13    // 0x0C8: ADDI x28, x0, 3       (i = 3)
FFFE0E13    // 0x0CC: ADDI x28, x28, -1     (loop: i--)
FE0E1EE3    // 0x0D0: BNE  x28, x0, -4      (backward branch to loop)
000E1063    // 0x0D4: BNE  x28, x0, 0       (guard: i must be 0)

// --- v2-3 Backward jump (negative J-immediate) - 3-pass loop ---
00300E13    // 0x0D8: ADDI x28, x0, 3       (i = 3)
FFFE0E13    // 0x0DC: ADDI x28, x28, -1     (loop: i--)
000E0463    // 0x0E0: BEQ  x28, x0, 8       (exit when i == 0)
FF9FF06F    // 0x0E4: JAL  x0, -8           (backward jump to loop)
000E1063    // 0x0E8: BNE  x28, x0, 0       (guard: i must be 0)

// --- v2-4 Negative store offset (S-immediate sign extension) ---
01000F13    // 0x0EC: ADDI x30, x0, 16      (base = 16)
FE1F2E23    // 0x0F0: SW   x1, -4(x30)      (must write mem[12] = 5)
00C02F83    // 0x0F4: LW   x31, 12(x0)      (read back from 12)
001F9063    // 0x0F8: BNE  x31, x1, 0       (guard: must be 5)

// --- v2-5 Shift amount = low 5 bits of rs2 only (33 -> 1) ---
02100F13    // 0x0FC: ADDI x30, x0, 33
01E09FB3    // 0x100: SLL  x31, x1, x30     (5<<1 = 10)
002F9063    // 0x104: BNE  x31, x2, 0       (guard: must be 10)
01E15FB3    // 0x108: SRL  x31, x2, x30     (10>>1 = 5)
001F9063    // 0x10C: BNE  x31, x1, 0       (guard: must be 5)

// --- v2-6 SB must write ONE byte (byte lane 1) ---
00302423    // 0x110: SW   x3, 8(x0)        (mem[8..11] = FFFFFFFF)
000004A3    // 0x114: SB   x0, 9(x0)        (clear byte 9 only)
00802F03    // 0x118: LW   x30, 8(x0)       (expect FFFF00FF)
FFFF0FB7    // 0x11C: LUI  x31, 0xFFFF0     (FFFF0000)
0FFF8F93    // 0x120: ADDI x31, x31, 255    (FFFF00FF)
01FF1063    // 0x124: BNE  x30, x31, 0      (guard: must be FFFF00FF)

// --- Upper Immediate (2) ---
00012E37    // 0x128: LUI   x28, 0x12       (00012000)
00010E97    // 0x12C: AUIPC x29, 0x10       (PC + 0x10000)

// --- Jumps (2) ---
00800F6F    // 0x130: JAL  x30, 8           (x30 = PC+4, jump over trap)
0000006F    // 0x134: JAL  x0, 0            (trap: stuck here = branch/jump before it failed)
00CF0FE7    // 0x138: JALR x31, 12(x30)     (x31 = PC+4, jump over trap to halt)
0000006F    // 0x13C: JAL  x0, 0            (trap: stuck here = branch/jump before it failed)

// --- Halt ---
0000006F    // 0x140: JAL  x0, 0            (HALT - tb expects PC to stop here)
