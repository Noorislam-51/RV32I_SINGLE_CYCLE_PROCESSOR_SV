// --- Setup ---
00500093    // 0x00: ADDI x1, x0, 5        (x1 = 5)
00A00113    // 0x04: ADDI x2, x0, 10       (x2 = 10)
FFF00193    // 0x08: ADDI x3, x0, -1       (x3 = 0xFFFFFFFF)

// --- R-Type (10) ---
00208233    // 0x0C: ADD  x4, x1, x2       (15)
401102B3    // 0x10: SUB  x5, x2, x1       (10-5 = 5)
00209333    // 0x14: SLL  x6, x1, x2       (5<<10 = 5120)
0011A3B3    // 0x18: SLT  x7, x3, x1       (signed -1<5 = 1; unsigned would give 0)
0030B433    // 0x1C: SLTU x8, x1, x3       (unsigned 5<FFFFFFFF = 1; signed would give 0)
0020C4B3    // 0x20: XOR  x9, x1, x2       (15)
00235533    // 0x24: SRL  x10, x6, x2      (5120>>10 = 5)
4021D5B3    // 0x28: SRA  x11, x3, x2      (-1>>>10 = -1; SRL would give 003FFFFF)
0020E633    // 0x2C: OR   x12, x1, x2      (15)
0020F6B3    // 0x30: AND  x13, x1, x2      (0)

// --- I-Type ALU (9) ---
00308713    // 0x34: ADDI  x14, x1, 3      (8)
00209793    // 0x38: SLLI  x15, x1, 2      (20)
0060A813    // 0x3C: SLTI  x16, x1, 6      (5<6 = 1)
FFF0B893    // 0x40: SLTIU x17, x1, -1     (5 < FFFFFFFF unsigned = 1)
0050C913    // 0x44: XORI  x18, x1, 5      (0)
00115993    // 0x48: SRLI  x19, x2, 1      (5)
4011DA13    // 0x4C: SRAI  x20, x3, 1      (-1; SRLI would give 7FFFFFFF)
0080EA93    // 0x50: ORI   x21, x1, 8      (13)
0070FB13    // 0x54: ANDI  x22, x1, 7      (5)

// --- Stores (3) ---
00102023    // 0x58: SW x1, 0(x0)          (mem[0..3] = 00000005)
00300223    // 0x5C: SB x3, 4(x0)          (mem[4]    = FF)
00301323    // 0x60: SH x3, 6(x0)          (mem[6..7] = FFFF)

// --- Loads (5) - negative data so sign/zero extension is actually tested ---
00002B83    // 0x64: LW  x23, 0(x0)        (00000005)
00400C03    // 0x68: LB  x24, 4(x0)        (FFFFFFFF sign-extended)
00601C83    // 0x6C: LH  x25, 6(x0)        (FFFFFFFF sign-extended)
00404D03    // 0x70: LBU x26, 4(x0)        (000000FF zero-extended)
00605D83    // 0x74: LHU x27, 6(x0)        (0000FFFF zero-extended)

// --- Branches (6) - each taken branch skips a trap; not-taken guard first ---
00109063    // 0x78: BNE  x1, x1, 0        (must NOT branch; if taken it loops here forever)
00108463    // 0x7C: BEQ  x1, x1, 8        (taken)
0000006F    // 0x80: JAL  x0, 0            (trap: stuck here = previous branch/jump failed)
00209463    // 0x84: BNE  x1, x2, 8        (taken)
0000006F    // 0x88: JAL  x0, 0            (trap: stuck here = previous branch/jump failed)
0011C463    // 0x8C: BLT  x3, x1, 8        (taken: -1 < 5 signed)
0000006F    // 0x90: JAL  x0, 0            (trap: stuck here = previous branch/jump failed)
0030D463    // 0x94: BGE  x1, x3, 8        (taken: 5 >= -1 signed)
0000006F    // 0x98: JAL  x0, 0            (trap: stuck here = previous branch/jump failed)
0030E463    // 0x9C: BLTU x1, x3, 8        (taken: 5 < FFFFFFFF unsigned)
0000006F    // 0xA0: JAL  x0, 0            (trap: stuck here = previous branch/jump failed)
0011F463    // 0xA4: BGEU x3, x1, 8        (taken: FFFFFFFF >= 5 unsigned)
0000006F    // 0xA8: JAL  x0, 0            (trap: stuck here = previous branch/jump failed)

// --- Upper Immediate (2) ---
00012E37    // 0xAC: LUI   x28, 0x12       (00012000)
00010E97    // 0xB0: AUIPC x29, 0x10       (PC + 0x10000)

// --- Jumps (2) ---
00800F6F    // 0xB4: JAL  x30, 8           (x30 = PC+4, jump over trap)
0000006F    // 0xB8: JAL  x0, 0            (trap: stuck here = previous branch/jump failed)
00CF0FE7    // 0xBC: JALR x31, 12(x30)     (x31 = PC+4, jump over trap to halt)
0000006F    // 0xC0: JAL  x0, 0            (trap: stuck here = previous branch/jump failed)

// --- Halt ---
0000006F    // 0xC4: JAL  x0, 0            (HALT - tb expects PC to stop here)
